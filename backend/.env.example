# ==========================================
# TreeMint Backend Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=treemint
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=treemint_jwt_super_secure_access_secret_2026_key
JWT_REFRESH_SECRET=treemint_jwt_super_secure_refresh_secret_2026_key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880 # 5 MB

# SMTP / Email Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@treemint.org

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
